# Publik (boleh terekspos ke browser)
PUBLIC_SITE_URL=https://rafizaweb.com
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
PUBLIC_GA4_ID=

# Penyimpanan sementara form (Google Apps Script → Google Sheets); dipakai bila Supabase belum diisi
SHEETS_WEBHOOK_URL=

# Server only — JANGAN beri prefix PUBLIC_ dan JANGAN di-commit
TURNSTILE_SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
MAIL_FROM="Rafizaweb <noreply@rafizaweb.com>"
MAIL_TO=admin@rafizaweb.com
IP_HASH_SALT=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Mode storage Keystatic: local (default dev) | github (production)
PUBLIC_KEYSTATIC_STORAGE=local
# Repo GitHub untuk storage github, format owner/nama-repo
PUBLIC_KEYSTATIC_REPO=

# true hanya untuk preview: izinkan data dummy/placeholder tayang
ALLOW_DUMMY=false
