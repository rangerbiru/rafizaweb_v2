---
import PageHero from '../components/layout/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import MapFacade from '../components/ui/MapFacade.astro';
import Turnstile from '../components/ui/Turnstile.astro';
import { path, useT, type Locale } from '../i18n';
import { usePages } from '../i18n/pages';
import BaseLayout from '../layouts/BaseLayout.astro';
import { isPlaceholder, settings } from '../lib/data';
import { breadcrumbNode, graph, webPageNode } from '../lib/schema';
import { waHref, waTrack } from '../lib/wa';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const p = usePages(locale).contact;
const url = path('contact', locale);
const crumbs = [
  { name: t.common.home, href: path('home', locale) },
  { name: t.nav.kontak, href: url },
];
const a = settings.address;
const jsonLd = graph(locale, [
  webPageNode({ url, name: p.title, description: p.description, locale, type: 'ContactPage' }),
  breadcrumbNode(crumbs.map((x) => ({ name: x.name, url: x.href }))),
]);
const inputCls =
  'h-[48px] w-full rounded-[12px] border border-border bg-surface px-[14px] text-[16px] text-navy aria-[invalid=true]:border-[#B42318]';
const errCls = 'm-0 text-[14px] font-semibold text-[#B42318] empty:hidden';
const req = `(${p.fields.required})`;
---

<BaseLayout
  title={p.title}
  description={p.description}
  locale={locale}
  routeKey="contact"
  jsonLd={jsonLd}
  bannerAbove="white"
>
  <PageHero locale={locale} crumbs={crumbs} badge={p.badge} title={p.h1} lead={p.lead} />
  <section class="bg-white" aria-label={p.h1}>
    <div class="rz-container flex flex-wrap items-start gap-[24px] pb-[clamp(48px,7.5vw,104px)]">
      <div class="flex min-w-0 flex-[1_1_340px] flex-col gap-[24px]">
        <div class="flex flex-col items-start gap-[12px] rounded-panel bg-navy p-[clamp(20px,3vw,32px)] text-white shadow-raised">
          <span class="flex size-[48px] items-center justify-center rounded-[14px] bg-wa text-white">
            <Icon name="wa" size={24} />
          </span>
          <h2 class="rz-h3 text-white">{p.waTitle}</h2>
          <p class="m-0 text-border">{p.waText(t.common.replyPromise)}</p>
          <a
            href={waHref(t.wa.general)}
            class="rz-btn mt-[4px] inline-flex h-[52px] w-full items-center justify-center gap-[10px] rounded-pill bg-brand px-[24px] text-[16px] font-bold text-white no-underline hover:text-white"
            {...waTrack('contact', { locale })}
          >
            <Icon name="wa" />
            {t.common.cta}
          </a>
        </div>
        <div class="flex flex-col gap-[10px] rounded-panel border border-border bg-surface p-[24px]">
          <h2 class="rz-h3">{p.infoTitle}</h2>
          <address class="flex flex-col gap-[10px] text-[15.5px] text-text-2 not-italic">
            <span class="flex gap-[10px]">
              <Icon name="pin" class="mt-[4px] shrink-0 text-brand" />
              {`${a.street}, ${a.city}, ${a.region} ${a.postal}`}
            </span>
            <a href={`mailto:${settings.email}`} class="flex gap-[10px]">
              <Icon name="mail" class="mt-[4px] shrink-0 text-brand" />
              {settings.email}
            </a>
            <span class="flex gap-[10px]" data-placeholder={isPlaceholder(settings.hours) ? '' : undefined}>
              <Icon name="clock" class="mt-[4px] shrink-0 text-brand" />
              {t.footer.hours}: {t.footer.hoursValue}
            </span>
          </address>
        </div>
      </div>

      <div class="flex min-w-0 flex-[2_1_480px] flex-col gap-[16px] rounded-panel border border-border bg-white p-[clamp(20px,3vw,32px)] shadow-card">
        <h2 class="rz-h3">{p.formTitle}</h2>
        <p class="m-0 text-text-2">{p.formLead}</p>
        <p
          id="kontak-terkirim"
          class="rz-sent m-0 flex items-center gap-[8px] rounded-[12px] bg-brand-50 p-[16px] font-semibold text-navy"
          role="status"
          tabindex="-1"
        >
          <Icon name="check" stroke={2.6} class="shrink-0 text-wa" />
          {p.success}
        </p>
        <form
          method="post"
          action="/api/contact"
          novalidate
          class="flex flex-col gap-[16px]"
          data-contact-form
          data-messages={JSON.stringify(p.errors)}
        >
          <div class="grid gap-[16px] md:grid-cols-2">
            <div class="flex flex-col gap-[6px]">
              <label for="c-name" class="text-[15px] font-bold">
                {p.fields.name} <span class="font-normal text-muted">{req}</span>
              </label>
              <input
                id="c-name"
                name="name"
                required
                minlength="2"
                maxlength="100"
                autocomplete="name"
                class={inputCls}
                aria-describedby="c-name-err"
              />
              <p id="c-name-err" class={errCls} data-error-for="name"></p>
            </div>
            <div class="flex flex-col gap-[6px]">
              <label for="c-wa" class="text-[15px] font-bold">
                {p.fields.whatsapp} <span class="font-normal text-muted">{req}</span>
              </label>
              <input
                id="c-wa"
                name="whatsapp"
                type="tel"
                required
                inputmode="tel"
                autocomplete="tel"
                pattern="\+?[0-9 \-]{8,20}"
                class={inputCls}
                aria-describedby="c-wa-hint c-wa-err"
                dir="ltr"
              />
              <p id="c-wa-hint" class="m-0 text-[13.5px] text-muted">
                {p.fields.whatsappHint}
              </p>
              <p id="c-wa-err" class={errCls} data-error-for="whatsapp"></p>
            </div>
          </div>
          <div class="flex flex-col gap-[6px]">
            <label for="c-email" class="text-[15px] font-bold">
              {p.fields.email}
            </label>
            <input
              id="c-email"
              name="email"
              type="email"
              autocomplete="email"
              class={inputCls}
              aria-describedby="c-email-err"
              dir="ltr"
            />
            <p id="c-email-err" class={errCls} data-error-for="email"></p>
          </div>
          <div class="grid gap-[16px] md:grid-cols-2">
            <div class="flex flex-col gap-[6px]">
              <label for="c-service" class="text-[15px] font-bold">
                {p.fields.service}
              </label>
              <select id="c-service" name="service" class={inputCls}>
                {p.serviceOptions.map((o) => (
                  <option value={o.v}>{o.l}</option>
                ))}
              </select>
            </div>
            <div class="flex flex-col gap-[6px]">
              <label for="c-budget" class="text-[15px] font-bold">
                {p.fields.budget}
              </label>
              <select id="c-budget" name="budget" class={inputCls}>
                {p.budgetOptions.map((o) => (
                  <option value={o.v}>{o.l}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="flex flex-col gap-[6px]">
            <label for="c-msg" class="text-[15px] font-bold">
              {p.fields.message} <span class="font-normal text-muted">{req}</span>
            </label>
            <textarea
              id="c-msg"
              name="message"
              required
              minlength="10"
              maxlength="4000"
              rows="5"
              class={`${inputCls} h-auto py-[12px]`}
              aria-describedby="c-msg-hint c-msg-err"
            ></textarea>
            <p id="c-msg-hint" class="m-0 text-[13.5px] text-muted">
              {p.fields.messageHint}
            </p>
            <p id="c-msg-err" class={errCls} data-error-for="message"></p>
          </div>
          <div class="flex flex-col gap-[6px]">
            <label class="flex items-start gap-[10px] text-[15px] text-text-2">
              <input
                type="checkbox"
                name="consent"
                value="true"
                required
                class="mt-[3px] size-[20px] shrink-0 accent-brand"
                aria-describedby="c-consent-err"
              />
              <span>
                {p.fields.consent} <a href={path('privacy', locale)}>{t.footer.privacy}</a>.{' '}
                <span class="text-muted">{req}</span>
              </span>
            </label>
            <p id="c-consent-err" class={errCls} data-error-for="consent"></p>
          </div>
          <input type="hidden" name="locale" value={locale} />
          <input type="hidden" name="source_page" value={url} />
          <div class="hidden" aria-hidden="true">
            <label>
              Website
              <input type="text" name="company_website" tabindex="-1" autocomplete="off" />
            </label>
          </div>
          <Turnstile action="contact" />
          <p class="m-0 font-semibold text-[#B42318] empty:hidden" role="alert" data-form-status></p>
          <button
            type="submit"
            class="rz-btn inline-flex h-[52px] items-center justify-center rounded-pill bg-brand px-[28px] text-[16px] font-bold text-white disabled:opacity-70 max-md:w-full md:self-start"
            data-sending={p.sending}
          >
            {p.submit}
          </button>
        </form>
      </div>

      <div class="flex min-w-0 flex-[1_1_100%] flex-col gap-[12px]">
        <h2 class="rz-h3">{p.mapTitle}</h2>
        <MapFacade
          query={`${settings.businessName}, ${a.street}, ${a.city}`}
          label={p.mapLoad}
          note={p.mapNote}
          title={p.mapTitle}
        />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Tanpa JS: endpoint redirect ke ?terkirim=1#kontak-terkirim sehingga pesan sukses tampil lewat :target. */
  .rz-sent {
    display: none;
  }
  .rz-sent:target,
  .rz-sent[data-show] {
    display: flex;
  }
</style>

<script>
  import '../scripts/forms';
</script>
