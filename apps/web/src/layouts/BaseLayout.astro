---
import arabicWoff2 from '@fontsource/noto-sans-arabic/files/noto-sans-arabic-arabic-400-normal.woff2?url';
import soraWoff2 from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import CtaBanner from '../components/layout/CtaBanner.astro';
import Drawer from '../components/layout/Drawer.astro';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import MobileBar from '../components/layout/MobileBar.astro';
import ArabicFont from '../components/seo/ArabicFont.astro';
import Analytics from '../components/seo/Analytics.astro';
import { dirOf, hasLocale, LOCALES, path, useT, type Locale, type RouteKey } from '../i18n';
import { SITE } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale?: Locale;
  routeKey?: RouteKey;
  /** Path kanonis (dengan slash akhir). Default: path halaman saat ini. */
  canonicalPath?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: string;
  isHome?: boolean;
  banner?: boolean;
  bannerAbove?: 'surface' | 'white' | 'navy';
  publishedTime?: string;
  modifiedTime?: string;
}
const {
  title,
  description,
  locale = 'id',
  routeKey,
  canonicalPath,
  ogImage,
  ogType = 'website',
  noindex = false,
  jsonLd,
  isHome = false,
  banner = true,
  bannerAbove = 'surface',
  publishedTime,
  modifiedTime,
} = Astro.props;

const t = useT(locale);
const dir = dirOf(locale);
const pathname =
  canonicalPath ?? (Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`);
const canonical = new URL(pathname, SITE).href;
const og = new URL(ogImage ?? `/og${pathname === '/' ? '/home' : pathname.replace(/\/$/, '')}.png`, SITE)
  .href;
const alternates =
  routeKey && !noindex
    ? LOCALES.filter((l) => hasLocale(routeKey, l)).map((l) => ({
        l,
        href: new URL(path(routeKey, l), SITE).href,
      }))
    : [];
const ogLocale: Record<Locale, string> = { id: 'id_ID', en: 'en_US', ar: 'ar_AR' };
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang={locale} dir={dir} class="no-js" data-env={isDev ? 'dev' : 'prod'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {alternates.length > 1 && alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    {alternates.length > 1 && (
      <link rel="alternate" hreflang="x-default" href={alternates.find((a) => a.l === 'id')?.href} />
    )}
    {locale === 'ar' ? (
      <link rel="preload" href={arabicWoff2} as="font" type="font/woff2" crossorigin />
    ) : (
      <link rel="preload" href={soraWoff2} as="font" type="font/woff2" crossorigin />
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1D4ED8" />
    <link rel="alternate" type="application/rss+xml" title="Blog Rafizaweb" href={`${SITE}/rss.xml`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Rafizaweb" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[locale]} />
    {alternates.length > 1 &&
      LOCALES.filter((l) => l !== locale && alternates.some((a) => a.l === l)).map((l) => (
        <meta property="og:locale:alternate" content={ogLocale[l]} />
      ))}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {locale === 'ar' && <ArabicFont />}
    <slot name="head" />
    <Analytics />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-100 rounded-pill bg-navy px-[18px] py-[10px] font-bold text-white focus:not-sr-only focus:fixed focus:start-[12px] focus:top-[12px]"
    >
      {t.common.skip}
    </a>
    <Header locale={locale} routeKey={routeKey} isHome={isHome} />
    <Drawer locale={locale} routeKey={routeKey} isHome={isHome} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    {banner && <CtaBanner locale={locale} isHome={isHome} above={bannerAbove} />}
    <Footer locale={locale} />
    <MobileBar locale={locale} isHome={isHome} />
    <script>
      import '../scripts/analytics';
      import '../scripts/reveal';
    </script>
  </body>
</html>
