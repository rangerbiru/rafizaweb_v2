---
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import { alternate, LOCALES, path, useT, type Locale, type RouteKey } from '../../i18n';
import { settings } from '../../lib/data';
import { waHref, waTrack } from '../../lib/wa';

interface Props {
  locale: Locale;
  routeKey?: RouteKey;
  isHome?: boolean;
}
const { locale, routeKey, isHome = false } = Astro.props;
const t = useT(locale);
const home = path('home', locale);
const anchor = (id: string) => (isHome ? `#${id}` : `${home}#${id}`);

const navDesk = [
  { id: 'layanan', href: path('services', locale), key: 'services' },
  { id: 'portofolio', href: path('portfolio', locale), key: 'portfolio' },
  { id: 'harga', href: path('pricing', locale), key: 'pricing' },
  { id: 'blog', href: path('blog', locale), key: 'blog' },
  { id: 'tentang', href: path('about', locale), key: 'about' },
] as const;
const current = (key: string) =>
  routeKey && (routeKey === key || (key === 'services' && String(routeKey).startsWith('service:')));
const langCodes: Record<Locale, string> = { id: 'ID', en: 'EN', ar: 'AR' };
---

<header data-header class="pointer-events-none sticky top-0 z-30 -mb-[84px] h-[84px] px-[12px] pt-[12px]">
  <div
    data-header-pill
    class="rz-header-pill pointer-events-auto mx-auto flex h-[60px] max-w-site items-center gap-[12px] rounded-pill border border-white/90 ps-[16px] pe-[8px]"
  >
    <Logo href={home} />

    <nav
      aria-label={t.common.navLabel}
      class="hidden min-w-0 flex-auto items-center justify-center gap-[2px] text-[15px] font-semibold whitespace-nowrap lg:flex"
    >
      {navDesk.map((n) => (
        <a
          href={n.href}
          class:list={['rz-nav rounded-pill px-[14px] py-[9px]', current(n.key) && 'rz-on']}
          aria-current={current(n.key) ? 'page' : undefined}
        >
          {t.nav[n.id]}
        </a>
      ))}
      <div class="relative" data-dropdown>
        <button
          type="button"
          class="rz-navbtn flex items-center gap-[6px] rounded-pill border-0 bg-transparent px-[14px] py-[9px] text-[15px] font-semibold text-navy"
          aria-expanded="false"
          aria-controls="eco-menu"
          data-dropdown-toggle
        >
          {t.common.eco}
          <Icon name="chevron" size={14} stroke={2.4} class="rz-chev transition-transform duration-200" />
        </button>
        <div
          id="eco-menu"
          hidden
          class="animate-swap absolute -start-[80px] top-[calc(100%+12px)] z-60 flex w-[300px] flex-col gap-[2px] rounded-card border border-border bg-white p-[8px] whitespace-normal shadow-raised"
        >
          <a
            href={anchor('ekosistem')}
            class="rz-menuopt flex gap-[12px] rounded-[12px] p-[12px] text-navy no-underline"
            data-close-dropdown
          >
            <span class="flex size-[40px] shrink-0 items-center justify-center rounded-[12px] bg-brand-50 text-brand">
              <Icon name="academy" size={20} />
            </span>
            <span class="flex flex-col leading-[1.35]">
              <strong class="text-[15px]">{t.nav.academy}</strong>
              <span class="text-[13.5px] font-medium text-muted">{t.common.academyDesc}</span>
            </span>
          </a>
          <a
            href={settings.socials.lynk}
            class="rz-menuopt flex gap-[12px] rounded-[12px] p-[12px] text-navy no-underline"
            target="_blank"
            rel="noopener"
          >
            <span class="flex size-[40px] shrink-0 items-center justify-center rounded-[12px] bg-brand-50 text-brand">
              <Icon name="bag" size={20} />
            </span>
            <span class="flex flex-col leading-[1.35]">
              <strong class="text-[15px]">{t.nav.store}</strong>
              <span class="text-[13.5px] font-medium text-muted">{t.common.storeDesc}</span>
            </span>
          </a>
        </div>
      </div>
    </nav>

    <div class="ms-auto flex shrink-0 items-center gap-[8px]">
      <div class="relative hidden lg:block" data-dropdown>
        <button
          type="button"
          class="rz-navbtn flex h-[44px] items-center gap-[6px] rounded-pill border-0 bg-transparent px-[12px] text-[14px] font-bold text-navy"
          aria-expanded="false"
          aria-controls="lang-menu"
          aria-label={`${langCodes[locale]}, ${t.common.langLabel}`}
          data-dropdown-toggle
        >
          <Icon name="globe" size={18} />
          <span>{langCodes[locale]}</span>
          <Icon name="chevron" size={14} stroke={2.4} class="rz-chev transition-transform duration-200" />
        </button>
        <ul
          id="lang-menu"
          hidden
          aria-label={t.common.langLabel}
          class="animate-swap absolute end-0 top-[calc(100%+12px)] z-60 m-0 flex w-[220px] list-none flex-col gap-[2px] rounded-card border border-border bg-white p-[6px] shadow-raised"
        >
          {LOCALES.map((l) => (
            <li>
              <a
                href={alternate(routeKey, l)}
                hreflang={l}
                lang={l}
                data-lang-link={l}
                data-lang-from={locale}
                aria-current={l === locale ? 'true' : undefined}
                class:list={[
                  'rz-langopt flex min-h-[44px] w-full items-center gap-[12px] rounded-[12px] px-[12px] py-[8px] text-[15px] font-semibold',
                  l === locale && 'rz-on',
                ]}
              >
                <span
                  class:list={[
                    'flex h-[26px] w-[34px] shrink-0 items-center justify-center rounded-[12px] text-[12px] font-extrabold',
                    l === locale ? 'bg-brand text-white' : 'bg-surface text-text-2',
                  ]}
                >
                  {langCodes[l]}
                </span>
                <span dir={l === 'ar' ? 'rtl' : 'ltr'} class="flex-1">
                  {t.langs[l]}
                </span>
                {l === locale && <Icon name="check" size={16} stroke={2.8} class="text-brand" />}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <a
        href={waHref(t.wa.general)}
        class="rz-btn hidden h-[46px] items-center gap-[8px] rounded-pill bg-brand px-[20px] text-[15px] font-bold whitespace-nowrap text-white no-underline shadow-raised hover:text-white lg:flex"
        {...waTrack('header', { locale })}
      >
        <Icon name="wa" size={18} />
        {t.common.cta}
      </a>
      <button
        type="button"
        class="flex size-[44px] items-center justify-center rounded-pill border border-border bg-white p-0 text-navy lg:hidden"
        aria-label={t.common.openMenu}
        aria-expanded="false"
        aria-controls="drawer"
        data-drawer-open
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
</header>

<style>
  /* Kaca: latar putih semi-transparan dengan blur tinggi. Warna konten di belakang header menyatu lembut,
     dan teks tetap hitam (navy) di atas section terang maupun gelap (kontras AA lewat lapisan putih 55–62%). */
  .rz-header-pill {
    background: rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    backdrop-filter: blur(28px) saturate(1.8);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.8),
      inset 0 -1px 0 rgba(255, 255, 255, 0.25),
      0 12px 32px -20px rgba(11, 26, 46, 0.4),
      0 0 0 1px rgba(11, 26, 46, 0.05);
    transition:
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  [data-header][data-scrolled] .rz-header-pill {
    background: rgba(255, 255, 255, 0.62);
    -webkit-backdrop-filter: blur(32px) saturate(1.9);
    backdrop-filter: blur(32px) saturate(1.9);
  }
  [aria-expanded='true'] > :global(.rz-chev) {
    transform: rotate(180deg);
  }
</style>

<script>
  import '../../scripts/header';
</script>
