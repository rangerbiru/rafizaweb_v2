---
import Icon from '../ui/Icon.astro';
import { useT, type Locale } from '../../i18n';
import { waHref, waTrack } from '../../lib/wa';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
---

<a
  data-mobile-bar
  href={waHref(t.wa.general)}
  aria-label={t.mobileBar.label}
  class="rz-wafab fixed bottom-[calc(16px+env(safe-area-inset-bottom,0px))] z-35 flex size-[60px] items-center justify-center rounded-pill bg-wa text-white no-underline hover:text-white md:hidden"
  {...waTrack('mobile_bar', { locale })}
>
  <Icon name="wa" size={32} />
</a>

<style>
  .rz-wafab {
    inset-inline-end: 16px;
    box-shadow: 0 12px 28px -10px rgba(22, 163, 74, 0.7);
    /* Tanpa backdrop-filter: pada elemen fixed di bawah layar, browser HP sering baru menggambarnya setelah scroll. */
    will-change: transform, opacity;
    transform: translateZ(0);
    transition:
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 0.3s ease;
  }
  .rz-wafab[data-hidden],
  :global(html[data-menu-open]) .rz-wafab {
    transform: translate3d(0, 160%, 0);
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .rz-wafab {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/mobile-bar';
</script>
