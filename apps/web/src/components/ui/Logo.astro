---
/**
 * Logo resmi Rafizaweb (src/assets/brand). tone="dark": teks hitam (header, drawer, latar terang).
 * tone="light": teks putih, khusus footer yang berlatar navy.
 */
import { Image } from 'astro:assets';
import lockup from '../../assets/brand/logo-lockup.png';
import lockupDark from '../../assets/brand/logo-lockup-dark.png';

interface Props {
  href?: string;
  label?: string;
  size?: 'md' | 'lg';
  tone?: 'dark' | 'light';
}
const { href, label = 'Rafizaweb', size = 'md', tone = 'dark' } = Astro.props;
const Tag = href ? 'a' : 'span';
const h = size === 'lg' ? 52 : 38;
// md: 34px di mobile, 30px di lebar 1024–1279 (menu horizontal padat), 38px di layar lebar.
const cls = size === 'lg' ? 'h-[52px]' : 'h-[34px] lg:h-[30px] xl:h-[38px]';
---

<Tag href={href} aria-label={href ? label : undefined} class="flex shrink-0 items-center no-underline">
  <Image
    src={tone === 'light' ? lockupDark : lockup}
    alt={href ? '' : label}
    height={h * 2}
    format="webp"
    quality={90}
    loading={href ? 'eager' : 'lazy'}
    class:list={['block w-auto', cls]}
    draggable="false"
  />
</Tag>
