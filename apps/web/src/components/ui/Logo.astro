---
/** Logo sementara dari desain (mark + wordmark). Ganti dengan SVG resmi saat P11 tersedia. */
interface Props {
  href?: string;
  label?: string;
  size?: 'md' | 'lg';
  tone?: 'dark' | 'light';
  mark?: boolean;
}
const { href, label = 'Rafizaweb', size = 'md', tone = 'dark', mark = true } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag
  href={href}
  aria-label={href ? label : undefined}
  class:list={[
    'flex shrink-0 items-center gap-[9px] no-underline',
    tone === 'dark' ? 'text-navy' : 'text-white',
  ]}
>
  {mark && (
    <span aria-hidden="true" class="relative block size-[34px] rounded-[12px] bg-brand">
      <span class="absolute start-[8px] top-[8px] h-[18px] w-[11px] rounded-[3px] bg-white" />
      <span class="absolute start-[21px] top-[8px] size-[6px] rounded-[2px] bg-amber" />
    </span>
  )}
  <span
    class:list={[
      'font-heading font-extrabold tracking-[-0.03em]',
      size === 'lg' ? 'text-[24px]' : 'text-[19px]',
      tone === 'light' && 'text-white',
    ]}
    dir="ltr"
  >
    rafizaweb
  </span>
</Tag>
