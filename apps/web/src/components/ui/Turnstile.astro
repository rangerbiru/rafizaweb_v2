---
/**
 * Widget Cloudflare Turnstile (mode managed/invisible). Hanya dirender jika PUBLIC_TURNSTILE_SITE_KEY diisi.
 * Script Turnstile dimuat lazy oleh scripts/forms.ts saat form pertama kali dipakai.
 */
interface Props {
  action: string;
}
const { action } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

{siteKey && (
  <div
    class="cf-turnstile"
    data-sitekey={siteKey}
    data-action={action}
    data-size="flexible"
    data-appearance="interaction-only"
  />
)}
