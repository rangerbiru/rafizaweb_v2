---
/** Peta Google Maps yang baru dimuat setelah diklik (facade, PRD §9.5). */
interface Props {
  query: string;
  label: string;
  note: string;
  title: string;
  /** dark: dipakai di atas latar navy (footer). */
  tone?: 'light' | 'dark';
  /** compact: tinggi tetap mengikuti kolom, bukan rasio 4:3/16:9. */
  compact?: boolean;
}
const { query, label, note, title, tone = 'light', compact = false } = Astro.props;
const src = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
---

<div
  class:list={[
    'relative flex w-full flex-col items-center justify-center gap-[10px] overflow-hidden rounded-card border p-[20px] text-center',
    compact ? 'h-full min-h-[220px]' : 'aspect-[4/3] md:aspect-video',
    tone === 'dark' ? 'border-white/15 bg-white/5' : 'border-border bg-brand-50',
  ]}
  data-map={src}
  data-map-title={title}
>
  <button
    type="button"
    class="rz-btn inline-flex min-h-[44px] items-center gap-[8px] rounded-pill bg-white px-[18px] text-[15px] font-bold text-navy shadow-card"
    data-map-load
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"></path>
      <circle cx="12" cy="9.5" r="2.5"></circle>
    </svg>
    {label}
  </button>
  <p class:list={['m-0 text-[13.5px]', tone === 'dark' ? 'text-border' : 'text-muted']}>{note}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.map!;
      f.title = box.dataset.mapTitle ?? 'Map';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.className = 'absolute inset-0 size-full border-0';
      box.replaceChildren(f);
    });
  });
</script>
