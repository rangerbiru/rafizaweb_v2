---
import Icon from './Icon.astro';
import { formatPrice, useT, type Locale } from '../../i18n';
import type { Plan } from '../../lib/data';
import { waHref, waTrack } from '../../lib/wa';

interface Props {
  plan: Plan;
  locale: Locale;
  rec?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { plan, locale, rec = false, headingLevel: H = 'h3' } = Astro.props;
const t = useT(locale);
---

<div
  data-plan-card={plan.key}
  data-rec={rec ? '' : undefined}
  class="rz-plan relative flex min-w-0 flex-[1_1_300px] flex-col gap-[16px] rounded-card bg-white p-[24px] md:gap-[20px] md:p-[28px]"
>
  <span class="rz-recbadge absolute -top-[14px] start-[20px] rounded-pill bg-amber px-[12px] py-[5px] text-[13px] font-extrabold text-navy md:start-[24px]">
    {t.pricing.rec}
  </span>
  <div class="flex flex-col gap-[4px]">
    <H class="m-0 font-heading text-[19px] font-bold tracking-[-0.02em] md:text-[22px]">{plan.name}</H>
    <span class="text-[15px] text-text-2">{plan.desc}</span>
  </div>
  <div class="flex flex-col gap-[2px] tabular-nums">
    <span
      class="rz-price font-heading text-[34px] leading-[1.15] font-extrabold tracking-[-0.04em] md:text-[40px]"
      dir={locale === 'ar' ? undefined : 'ltr'}
    >
      {formatPrice(plan.price, locale)}
    </span>
    <span class="text-[14px] text-muted">{t.pricing.renew(formatPrice(plan.renewal, locale))}</span>
    <span class="text-[14px] text-muted">{t.pricing.time(plan.time)}</span>
  </div>
  <ul class="m-0 flex list-none flex-col gap-[8px] border-t border-border p-0 pt-[14px] text-[15px] md:gap-[10px] md:pt-[16px]">
    {plan.features.map((f) => (
      <li class="flex gap-[10px]">
        <Icon name="check" stroke={2.4} class="mt-[3px] shrink-0 text-brand" />
        {f}
      </li>
    ))}
  </ul>
  <a
    href={waHref(t.wa.plan(plan.name))}
    class="rz-btn rz-plancta mt-auto flex h-[50px] items-center justify-center rounded-pill border-[1.5px] border-brand text-[15.5px] font-bold no-underline"
    {...waTrack('pricing', { plan: plan.key, locale })}
  >
    {t.common.cta}
    <span class="sr-only">: {plan.name}</span>
  </a>
</div>

<style>
  .rz-plan {
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.35s var(--ease-standard),
      box-shadow 0.35s ease;
  }
  .rz-recbadge {
    display: none;
  }
  /* Format AR "4,999,000 روبية" lebih panjang; perkecil agar tidak terpotong. */
  :global([lang='ar']) .rz-price {
    font-size: 30px;
  }
  .rz-price {
    color: var(--color-navy);
  }
  .rz-plancta {
    background: var(--color-white);
    color: var(--color-brand);
  }
  .rz-plan[data-rec] {
    border: 2px solid var(--color-brand);
    box-shadow: var(--shadow-raised);
  }
  .rz-plan[data-rec] .rz-recbadge {
    display: inline-block;
    animation: var(--animate-pop);
  }
  .rz-plan[data-rec] .rz-price {
    color: var(--color-brand);
  }
  .rz-plan[data-rec] .rz-plancta {
    background: var(--color-brand);
    color: var(--color-white);
  }
  @media (min-width: 768px) {
    .rz-plan[data-rec] {
      transform: translateY(-8px);
    }
  }
</style>
