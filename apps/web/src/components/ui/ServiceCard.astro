---
import Icon from './Icon.astro';
import type { Service } from '../../lib/data';

interface Props {
  service: Service;
  href: string;
  cta: string;
  soonLabel?: string;
}
const { service: s, href, cta, soonLabel } = Astro.props;
const icons: Record<string, 'layout' | 'building' | 'cart' | 'device' | 'trending' | 'academy'> = {
  lp: 'layout',
  cp: 'building',
  toko: 'cart',
  app: 'device',
  seo: 'trending',
  kelas: 'academy',
};
const icon = icons[s.key] ?? 'layout';
---

<article class="rz-card relative flex min-w-0 flex-col gap-[14px] rounded-card border border-border bg-white p-[24px] shadow-card">
  <div class="flex items-start justify-between gap-[12px]">
    <span
      class="flex size-[52px] shrink-0 items-center justify-center rounded-[16px] border border-brand/10 bg-brand-50/70 text-brand"
      aria-hidden="true"
    >
      <Icon name={icon} size={26} stroke={1.8} />
    </span>
    <span
      class:list={[
        'shrink-0 rounded-pill px-[10px] py-[4px] text-[12.5px] font-bold',
        s.soon ? 'bg-amber text-navy' : 'bg-brand-50 text-brand',
      ]}
    >
      {s.soon ? (soonLabel ?? s.priceShort) : s.priceShort}
    </span>
  </div>
  <h2 class="m-0 font-heading text-[clamp(19px,1.6vw,22px)] leading-[1.25] font-bold tracking-[-0.02em]">
    <a href={href} class="rz-stretch text-navy no-underline hover:text-brand">
      {s.name}
    </a>
  </h2>
  <p class="m-0 text-[14.5px] font-semibold text-muted">{s.tagline}</p>
  <p class="m-0 text-[15.5px] text-text-2">{s.desc}</p>
  <ul class="m-0 flex list-none flex-col gap-[8px] p-0 text-[15px]">
    {s.points.map((p) => (
      <li class="flex gap-[10px]">
        <Icon name="check" stroke={2.4} class="mt-[3px] shrink-0 text-brand" />
        {p}
      </li>
    ))}
  </ul>
  <span
    class="mt-auto inline-flex items-center gap-[6px] pt-[4px] text-[15px] font-bold text-brand"
    aria-hidden="true"
  >
    {cta}
    <Icon name="arrow" size={16} />
  </span>
</article>

<style>
  .rz-stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
  }
  .rz-stretch:focus-visible {
    outline: none;
  }
  .rz-stretch:focus-visible::after {
    outline: 3px solid var(--color-amber);
    outline-offset: 3px;
  }
</style>
