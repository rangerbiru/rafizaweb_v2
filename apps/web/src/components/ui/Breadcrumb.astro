---
import Icon from './Icon.astro';
interface Props {
  items: { name: string; href?: string }[];
  label: string;
}
const { items, label } = Astro.props;
---

<nav aria-label={label} class="text-[14px] font-semibold text-muted">
  <ol class="m-0 flex list-none flex-wrap items-center gap-[6px] p-0">
    {items.map((it, i) => (
      <li class="flex items-center gap-[6px]">
        {i > 0 && <Icon name="chevron-right" size={14} class="opacity-60" />}
        {it.href && i < items.length - 1 ? (
          <a href={it.href} class="text-muted no-underline hover:text-brand">
            {it.name}
          </a>
        ) : (
          <span aria-current={i === items.length - 1 ? 'page' : undefined} class="text-navy">
            {it.name}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
