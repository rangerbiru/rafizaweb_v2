      </>
    )}
    {name === 'tiktok' && (
      <>
        <path d="M14 3v11a4 4 0 1 1-4-4" />
        <path d="M14 3c.5 2.5 2.5 4 5 4" />
      </>
    )}
    {name === 'youtube' && (
      <>
        <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
