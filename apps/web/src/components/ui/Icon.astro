---
/**
 * Ikon SVG inline. Ikon arah (arrow, chevron-right, chevron-left) di-mirror di RTL lewat .rz-flip.
 */
interface Props {
  name:
    | 'check'
    | 'star'
    | 'chevron'
    | 'chevron-right'
    | 'arrow'
    | 'wa'
    | 'globe'
    | 'menu'
    | 'close'
    | 'search'
    | 'pen'
    | 'shield'
    | 'sparkle'
    | 'academy'
    | 'bag'
    | 'instagram'
    | 'tiktok'
    | 'youtube'
    | 'facebook'
    | 'mail'
    | 'pin'
    | 'clock'
    | 'link'
    | 'copy'
    | 'chat'
    | 'eye'
    | 'sliders'
    | 'layout'
    | 'building'
    | 'cart'
    | 'device'
    | 'trending'
    | 'refresh'
    | 'puzzle'
    | 'card';
  size?: number;
  class?: string;
  stroke?: number;
  style?: string;
}
const { name, size = 18, class: cls = '', stroke, style } = Astro.props;
const directional = ['arrow', 'chevron-right'].includes(name);
const sw = stroke ?? 2;
---

