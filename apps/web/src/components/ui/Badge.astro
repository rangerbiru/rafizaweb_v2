---
import Icon from './Icon.astro';
/** Badge kapsul dengan ikon bulat (hero) atau badge amber "Segera hadir". */
interface Props {
  tone?: 'brand' | 'amber';
  icon?: boolean;
  class?: string;
}
const { tone = 'brand', icon = true, class: cls } = Astro.props;
---

{tone === 'brand' ? (
  <span
    class:list={[
      'inline-flex items-center gap-[8px] rounded-pill bg-brand-50 py-[6px] ps-[6px] pe-[14px] text-[14px] font-bold text-brand',
      !icon && 'ps-[14px]',
      cls,
    ]}
  >
    {icon && (
      <span class="flex size-[24px] shrink-0 items-center justify-center rounded-full bg-brand text-white">
        <Icon name="sparkle" size={13} />
      </span>
    )}
    <slot />
  </span>
) : (
  <span
    class:list={[
      'inline-flex rounded-pill bg-amber px-[11px] py-[4px] text-[13px] font-extrabold text-navy',
      cls,
    ]}
  >
    <slot />
  </span>
)}
