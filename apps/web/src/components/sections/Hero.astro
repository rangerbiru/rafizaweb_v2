---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import { useT, type Locale } from '../../i18n';
import { ALLOW_DUMMY, settings } from '../../lib/data';
import { waHref, waTrack } from '../../lib/wa';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const words = t.hero.words;
const first = words[0]!;
const longest = words.reduce((a, b) => (b.length > a.length ? b : a), first);
const showRating = settings.reviewsEnabled && (!settings.ratingIsDummy || ALLOW_DUMMY);
const showLive = settings.liveSitesVerified;
---

<section id="top" class="rz-hero relative overflow-hidden">
  <div class="mx-auto flex max-w-site flex-wrap items-center gap-x-[48px] gap-y-[32px] px-[clamp(16px,3.4vw,48px)] pt-[clamp(104px,9vw,136px)] pb-[clamp(32px,4vw,56px)]">
    <div class="flex max-w-[640px] min-w-0 flex-[1_1_520px] flex-col items-start gap-[24px]">
      <Badge>{t.hero.badge}</Badge>
      <h1 class="rz-h1">
        <span class="block">{t.hero.h1a}</span>{' '}
        <span class="block whitespace-nowrap">
          {t.hero.h1pre}
          <span
            class="rz-caret text-brand"
            data-typing
            data-words={JSON.stringify(words)}
            data-longest={longest}
          >
            {first}
          </span>
          {t.hero.h1post}
        </span>{' '}
        <span class="block">{t.hero.h1c}</span>
      </h1>
      <p class="m-0 max-w-[34em] text-[clamp(16px,1.2vw,17px)] leading-[1.65] text-text-2">{t.hero.lead}</p>
      <div class="flex flex-wrap items-center gap-[12px] max-md:w-full">
        <a
          href={waHref(t.wa.general)}
          class="rz-btn inline-flex h-[52px] items-center justify-center gap-[10px] rounded-pill bg-brand px-[24px] text-[16px] font-bold text-white no-underline shadow-raised hover:text-white max-md:w-full"
          {...waTrack('hero', { locale })}
        >
          <Icon name="wa" />
          {t.common.cta}
        </a>
        <a
          href="#portofolio"
          class="rz-btn inline-flex h-[52px] items-center justify-center rounded-pill border border-border bg-white px-[24px] text-[16px] font-bold text-navy no-underline hover:text-navy max-md:w-full"
        >
          {t.common.cta2}
        </a>
      </div>
      {(showRating || showLive) && (
        <ul class="m-0 flex list-none flex-wrap gap-x-[24px] gap-y-[8px] p-0 text-[14px] font-semibold text-text-2">
          {showRating && (
            <li class="flex items-center gap-[8px]" data-dummy={settings.ratingIsDummy ? '' : undefined}>
              <Icon name="star" size={16} />
              {t.hero.proof1(settings.rating, settings.reviewCount)}
            </li>
          )}
          {showLive && (
            <li class="flex items-center gap-[8px]" data-dummy={!settings.liveSitesVerified ? '' : undefined}>
              <Icon name="check" size={16} stroke={2.4} class="text-brand" />
              {t.hero.proof2(settings.liveSites)}
            </li>
          )}
        </ul>
      )}
    </div>

    <div aria-hidden="true" data-parallax class="rz-visual relative min-w-0 flex-[1_1_440px]">
      <div class="rz-tablet absolute top-[2%] right-0 h-[80%] rounded-panel border border-border bg-white p-[10px]">
        <div
          dir="ltr"
          class="flex size-full flex-col overflow-hidden rounded-card border border-border bg-white"
        >
          <div class="flex items-center justify-between gap-[10px] px-[16px] py-[12px]">
            <span class="flex items-center gap-[6px] font-heading text-[11.5px] font-extrabold">
              <span class="size-[15px] rounded-[4px] bg-brand"></span>rafizaweb
            </span>
            <span class="flex items-center gap-[12px] text-[10px] font-semibold text-muted">
              {t.hero.mockNav.map((n, i) => (
                <span class:list={[i === 0 && 'text-brand']}>{n}</span>
              ))}
            </span>
          </div>
          <div class="flex min-h-0 flex-1 gap-[14px] px-[16px] pt-[4px] pb-[16px]">
            <div class="flex min-w-0 flex-[1_1_0] flex-col justify-center gap-[9px]">
              <span class="font-heading text-[clamp(14px,1.6vw,23px)] leading-[1.15] font-extrabold tracking-[-0.03em]">
                {t.hero.mockTitle}
              </span>
              <span class="block h-[6px] w-[92%] rounded-[3px] bg-border"></span>
              <span class="block h-[6px] w-[68%] rounded-[3px] bg-border"></span>
              <span class="mt-[6px] self-start rounded-pill bg-brand px-[11px] py-[6px] text-[10px] font-bold text-white">
                {t.hero.mockCta}
              </span>
            </div>
            <div class="rz-mock-img relative min-w-0 flex-[1.1_1_0] overflow-hidden rounded-[12px]">
              <svg
                class="absolute inset-0 size-full"
                viewBox="0 0 200 280"
                preserveAspectRatio="xMidYMax slice"
                focusable="false"
                aria-hidden="true"
              >
                <ellipse cx="100" cy="258" rx="92" ry="6" fill="#0B1A2E" opacity=".18" />
                <rect x="28" y="118" width="144" height="140" rx="6" fill="#FFFFFF" />
                <rect x="40" y="96" width="120" height="30" rx="8" fill="#0B1A2E" />
                <circle cx="56" cy="111" r="7" fill="#F5B83D" />
                <rect x="70" y="105" width="64" height="6" rx="3" fill="#FFFFFF" opacity=".9" />
                <rect x="70" y="115" width="40" height="5" rx="2.5" fill="#FFFFFF" opacity=".5" />
                <path d="M24.00 126h25.33v18a12.665 12.665 0 0 1-25.33 0z" fill="#F5B83D" />
                <path d="M49.33 126h25.33v18a12.665 12.665 0 0 1-25.33 0z" fill="#FFFFFF" />
                <path d="M74.66 126h25.33v18a12.665 12.665 0 0 1-25.33 0z" fill="#F5B83D" />
                <path d="M99.99 126h25.33v18a12.665 12.665 0 0 1-25.33 0z" fill="#FFFFFF" />
                <path d="M125.32 126h25.33v18a12.665 12.665 0 0 1-25.33 0z" fill="#F5B83D" />
                <path d="M150.65 126h25.33v18a12.665 12.665 0 0 1-25.33 0z" fill="#FFFFFF" />
                <rect x="40" y="160" width="70" height="64" rx="6" fill="#E6EDFD" />
                <rect x="40" y="190" width="70" height="3" fill="#1D4ED8" opacity=".25" />
                <rect x="48" y="176" width="14" height="14" rx="3" fill="#1D4ED8" />
                <rect x="67" y="178" width="14" height="12" rx="3" fill="#F5B83D" />
                <rect x="86" y="174" width="14" height="16" rx="3" fill="#16A34A" />
                <rect x="48" y="206" width="18" height="12" rx="3" fill="#F5B83D" />
                <rect x="72" y="202" width="14" height="16" rx="3" fill="#1D4ED8" />
                <circle cx="97" cy="212" r="6" fill="#16A34A" />
                <rect x="124" y="160" width="36" height="98" rx="5" fill="#1D4ED8" />
                <rect x="130" y="167" width="24" height="52" rx="3" fill="#E6EDFD" opacity=".92" />
                <rect x="134" y="228" width="16" height="8" rx="4" fill="#16A34A" />
                <circle cx="154" cy="238" r="2.5" fill="#F5B83D" />
                <path d="M100 84C86 66 78 56 78 44a22 22 0 0 1 44 0c0 12-8 22-22 40z" fill="#F5B83D" />
                <circle cx="100" cy="44" r="8" fill="#FFFFFF" />
              </svg>
            </div>
          </div>
        </div>
      </div>
      <div class="rz-par1 absolute bottom-[6%] left-0 z-3">
        <div class="animate-float flex items-center gap-[10px] rounded-card border border-border bg-white py-[12px] ps-[12px] pe-[18px] shadow-card">
          <span class="flex size-[40px] shrink-0 items-center justify-center rounded-[12px] bg-brand-50 text-brand">
            <Icon name="search" size={18} stroke={2.2} />
          </span>
          <span class="flex flex-col leading-[1.3]">
            <strong class="font-heading text-[15px]">{t.hero.chipTitle}</strong>
            <span class="text-[12.5px] text-muted">{t.hero.chipDesc}</span>
          </span>
        </div>
      </div>
      <div class="rz-par2 absolute right-[30%] bottom-0 z-2 hidden size-[72px] items-center justify-center rounded-card bg-brand text-white shadow-raised md:flex">
        <Icon name="pen" size={30} stroke={1.8} />
      </div>
      <div class="rz-par3 absolute right-[6%] bottom-[2%] z-2 hidden h-[72px] w-[104px] grid-cols-3 place-items-center gap-[8px] rounded-card border border-border bg-white p-[13px] shadow-card md:grid">
        <span class="size-[17px] rounded-full bg-amber"></span>
        <span class="size-[17px] rounded-full bg-brand"></span>
        <span class="size-[17px] rounded-full bg-navy"></span>
        <span class="size-[17px] rounded-full bg-brand-50"></span>
        <span class="size-[17px] rounded-full bg-wa"></span>
        <span class="size-[17px] rounded-full bg-border"></span>
      </div>
    </div>
  </div>
</section>

<style>
  .rz-hero {
    background-color: #f5f8ff;
    background-image:
      radial-gradient(720px 520px at 84% 38%, rgba(29, 78, 216, 0.16), transparent 70%),
      linear-gradient(180deg, #f5f8ff 0%, #ffffff 100%);
  }
  :global([dir='rtl']) .rz-hero {
    background-image:
      radial-gradient(720px 520px at 16% 38%, rgba(29, 78, 216, 0.16), transparent 70%),
      linear-gradient(180deg, #f5f8ff 0%, #ffffff 100%);
  }
  /* Kata yang diketik: lebar mengikuti teks, caret lewat ::after agar tidak ada elemen yang bergeser. */
  [data-typing] {
    display: inline-block;
    min-width: 0.5em;
  }

  /* Visual hero + parallax. JS hanya menyetel --hx/--hy (-0.5…0.5); transform dihitung CSS. */
  .rz-visual {
    --hx: 0;
    --hy: 0;
    --tilt-base: -12deg;
    height: 300px;
    perspective: 1800px;
  }
  :global([dir='rtl']) .rz-visual {
    --tilt-base: 12deg;
  }
  .rz-tablet {
    width: 100%;
    transform: rotateY(calc(var(--hx) * 14deg)) rotateX(calc(var(--hy) * -10deg));
    box-shadow: var(--shadow-raised);
    will-change: transform;
    transition:
      transform 0.35s var(--ease-standard),
      box-shadow 0.35s ease;
  }
  .rz-par1,
  .rz-par2,
  .rz-par3 {
    transition: transform 0.35s var(--ease-standard);
  }
  .rz-par1 {
    transform: translate(calc(var(--hx) * -22px), calc(var(--hy) * -18px));
  }
  .rz-par2 {
    transform: translate(calc(var(--hx) * 30px), calc(var(--hy) * 24px)) rotate(-8deg);
  }
  .rz-par3 {
    transform: translate(calc(var(--hx) * 18px), calc(var(--hy) * 14px)) rotate(-4deg);
  }
  .rz-visual[data-active] .rz-tablet {
    box-shadow: var(--shadow-lift);
  }
  @media (min-width: 768px) {
    .rz-visual {
      height: clamp(360px, 34vw, 480px);
    }
    .rz-tablet {
      width: 94%;
      transform: rotateY(calc(var(--tilt-base) + var(--hx) * 20deg)) rotateX(calc(4deg - var(--hy) * 16deg));
    }
  }
  .rz-mock-img {
    background: linear-gradient(165deg, #e6edfd 0%, #1d4ed8 100%);
  }
</style>

<script>
  import '../../scripts/typing';
  import '../../scripts/parallax';
</script>
