---
import { Image } from 'astro:assets';
import heroShadow from '../../assets/image/hero-shadow.jpg';
import Icon from '../ui/Icon.astro';
import { useT, type Locale } from '../../i18n';
import { ALLOW_DUMMY, settings } from '../../lib/data';
import { waHref, waTrack } from '../../lib/wa';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const words = t.hero.words;
const first = words[0]!;
const longest = words.reduce((a, b) => (b.length > a.length ? b : a), first);
const showRating = settings.reviewsEnabled && (!settings.ratingIsDummy || ALLOW_DUMMY);
const showLive = settings.liveSitesVerified;
---

<section id="top" class="rz-hero relative isolate overflow-hidden text-white">
  <Image
    src={heroShadow}
    alt=""
    widths={[768, 1280, 1920, 2400]}
    sizes="100vw"
    format="webp"
    quality={70}
    loading="eager"
    fetchpriority="high"
    class="rz-hero-img absolute inset-0 -z-20 size-full object-cover"
    draggable="false"
  />
  <div aria-hidden="true" class="rz-hero-shade absolute inset-0 -z-10"></div>

  <div class="mx-auto flex min-h-[clamp(620px,86svh,820px)] max-w-site flex-col items-center justify-center px-[clamp(16px,3.4vw,48px)] pt-[clamp(112px,10vw,148px)] pb-[clamp(56px,7vw,96px)] text-center">
    <div class="flex max-w-[820px] min-w-0 flex-col items-center gap-[clamp(20px,2.4vw,28px)]">
      <span class="inline-flex items-center gap-[8px] rounded-pill border border-white/20 bg-white/10 py-[6px] ps-[8px] pe-[16px] text-[14px] font-bold text-white backdrop-blur-sm">
        <span class="flex size-[24px] shrink-0 items-center justify-center rounded-full bg-amber text-navy">
          <Icon name="sparkle" size={13} />
        </span>
        {t.hero.badge}
      </span>
      <h1 class="rz-h1 text-white">
        <span class="block">{t.hero.h1a}</span>{' '}
        <span class="block whitespace-nowrap">
          {t.hero.h1pre}
          <span
            class="rz-caret text-amber"
            data-typing
            data-words={JSON.stringify(words)}
            data-longest={longest}
          >
            {first}
          </span>
          {t.hero.h1post}
        </span>{' '}
        <span class="block">{t.hero.h1c}</span>
      </h1>
      <p class="m-0 max-w-[36em] text-[clamp(16px,1.3vw,18px)] leading-[1.65] text-white/85">{t.hero.lead}</p>
      <div class="flex flex-wrap items-center justify-center gap-[12px] pt-[4px] max-md:w-full max-md:flex-col">
        <a
          href={waHref(t.wa.general)}
          class="rz-btn inline-flex h-[52px] items-center justify-center gap-[10px] rounded-pill bg-brand px-[28px] text-[16px] font-bold text-white no-underline shadow-raised hover:text-white max-md:w-full"
          {...waTrack('hero', { locale })}
        >
          <Icon name="wa" />
          {t.common.cta}
        </a>
        <a
          href="#portofolio"
          class="rz-btn inline-flex h-[52px] items-center justify-center rounded-pill border border-white/35 bg-white/10 px-[28px] text-[16px] font-bold text-white no-underline backdrop-blur-sm hover:text-white max-md:w-full"
        >
          {t.common.cta2}
        </a>
      </div>
      {(showRating || showLive) && (
        <ul class="m-0 flex list-none flex-wrap justify-center gap-x-[24px] gap-y-[8px] p-0 text-[14px] font-semibold text-white/80">
          {showRating && (
            <li class="flex items-center gap-[8px]" data-dummy={settings.ratingIsDummy ? '' : undefined}>
              <Icon name="star" size={16} class="text-amber" />
              {t.hero.proof1(settings.rating, settings.reviewCount)}
            </li>
          )}
          {showLive && (
            <li class="flex items-center gap-[8px]" data-dummy={!settings.liveSitesVerified ? '' : undefined}>
              <Icon name="check" size={16} stroke={2.4} class="text-amber" />
              {t.hero.proof2(settings.liveSites)}
            </li>
          )}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .rz-hero {
    background-color: var(--color-navy);
  }
  .rz-hero :global(.rz-h1) {
    font-size: clamp(38px, 5.4vw, 68px);
  }
  .rz-hero-img {
    object-position: 50% 40%;
  }
  /* Bayangan pohon tetap terlihat di tepi; bagian tengah digelapkan agar teks putih terbaca (AA). */
  .rz-hero-shade {
    background:
      radial-gradient(ellipse 70% 62% at 50% 52%, rgba(11, 26, 46, 0.86) 0%, rgba(11, 26, 46, 0.6) 100%),
      linear-gradient(180deg, rgba(11, 26, 46, 0.5) 0%, rgba(11, 26, 46, 0.1) 40%, rgba(11, 26, 46, 0.78) 100%);
  }
  @media (max-width: 767px) {
    .rz-hero-shade {
      background: linear-gradient(180deg, rgba(11, 26, 46, 0.82) 0%, rgba(11, 26, 46, 0.7) 100%);
    }
  }
  /* Kata yang diketik: lebar mengikuti teks, caret lewat ::after agar tidak ada elemen yang bergeser. */
  [data-typing] {
    display: inline-block;
    min-width: 0.5em;
  }
</style>

<script>
  import '../../scripts/typing';
</script>
