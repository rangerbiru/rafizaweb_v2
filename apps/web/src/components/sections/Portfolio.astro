---
/** Portofolio (PRD §6.6): preview besar + thumbnail (grid desktop, scroll-snap 46% mobile). */
import { path, useT, type Locale } from '../../i18n';
import { ALLOW_DUMMY, getPortfolioProjects, isPlaceholder, TINT } from '../../lib/data';
import { Picture } from 'astro:assets';
import { portfolioImage } from '../../lib/images';
import BrowserFrame from '../ui/BrowserFrame.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const projects = await getPortfolioProjects();
const initial = projects[0]?.id;
const showText = (v: string) => !!v && (!isPlaceholder(v) || ALLOW_DUMMY);
const initialOf = (name: string) => name.replace(/^(PT|CV)\s+/, '').charAt(0);
---

<section id="portofolio" aria-labelledby="rz-porto" class="bg-white">
  <div class="rz-container rz-section-pad flex flex-col gap-[clamp(24px,3vw,48px)]">
    <div class="flex flex-wrap items-end justify-between gap-x-[32px] gap-y-[12px]" data-reveal>
      <div class="flex max-w-[640px] flex-col gap-[12px]">
        <h2 id="rz-porto" class="rz-h2">
          {t.portfolio.title}
        </h2>
        <p class="rz-lead">{t.portfolio.lead}</p>
      </div>
      <a href={path('portfolio', locale)} class="rz-link text-[15px]">
        {t.portfolio.all}
      </a>
    </div>

    <div class="flex flex-wrap items-start gap-[24px]" data-gallery>
      <div class="min-w-0 flex-[999_1_600px]">
        {projects.map((p) => {
          const d = p.data;
          const on = p.id === initial;
          return (
            <article
              id={`proj-${p.id}`}
              data-proj={p.id}
              data-open={on ? '' : undefined}
              class="rz-proj overflow-hidden rounded-panel border border-border bg-white shadow-card"
              aria-labelledby={`proj-title-${p.id}`}
            >
              <div class="bg-brand-50 px-[clamp(14px,2.4vw,28px)] pt-[clamp(14px,2.4vw,28px)]">
                <BrowserFrame
                  domain={d.domain}
                  image={d.screenshotDesktop}
                  alt={`${d.name}`}
                  label={t.portfolio.shot(d.domain)}
                />
              </div>
              <div class="flex flex-wrap gap-x-[32px] gap-y-[16px] p-[clamp(20px,2.6vw,32px)]">
                <div class="flex min-w-0 flex-[1_1_220px] flex-col items-start gap-[8px]">
                  <span class="rounded-pill bg-brand-50 px-[10px] py-[4px] text-[13px] font-bold text-brand">
                    {t.portfolio.industries[d.industry]}
                  </span>
                  <h3 id={`proj-title-${p.id}`} class="rz-h3">
                    {d.name}
                  </h3>
                </div>
                {(showText(d.challenge) || showText(d.result)) && (
                  <dl class="m-0 flex min-w-0 flex-[2_1_300px] flex-col gap-[12px]">
                    {showText(d.challenge) && (
                      <div>
                        <dt class="text-[14px] text-muted">{t.portfolio.challenge}</dt>
                        <dd
                          class="mt-[2px] mb-0 ms-0 font-semibold"
                          data-placeholder={isPlaceholder(d.challenge) ? '' : undefined}
                        >
                          {d.challenge}
                        </dd>
                      </div>
                    )}
                    {showText(d.result) && (
                      <div>
                        <dt class="text-[14px] text-muted">{t.portfolio.result}</dt>
                        <dd
                          class="mt-[2px] mb-0 ms-0 font-semibold"
                          data-placeholder={isPlaceholder(d.result) ? '' : undefined}
                        >
                          {d.result}
                        </dd>
                      </div>
                    )}
                  </dl>
                )}
                <div class="flex flex-[1_1_100%] flex-wrap items-center gap-x-[24px] gap-y-[12px]">
                  {d.url && (
                    <a
                      href={d.url}
                      target="_blank"
                      rel="noopener"
                      class="rz-btn inline-flex h-[46px] items-center rounded-pill bg-navy px-[20px] text-[15px] font-bold text-white no-underline hover:text-white"
                    >
                      {t.portfolio.visit}
                      <span class="sr-only">
                        {d.name} {t.common.newTab}
                      </span>
                    </a>
                  )}
                  <a href={path(`project:${p.id}`, locale)} class="rz-link text-[15px]">
                    {t.portfolio.caseStudy}
                    <span class="sr-only">: {d.name}</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
      <div
        class="rz-thumbs rz-hscroll -mx-[16px] flex max-w-[calc(100%+32px)] min-w-0 flex-[1_1_300px] gap-[12px] overflow-x-auto px-[16px] pb-[4px] md:mx-0 md:grid md:max-w-full md:grid-cols-2 md:overflow-visible md:p-0"
        role="group"
        aria-label={t.portfolio.thumbsLabel}
      >
        {projects.map((p) => {
          const on = p.id === initial;
          return (
            <button
              type="button"
              aria-pressed={on ? 'true' : 'false'}
              aria-controls={`proj-${p.id}`}
              data-proj-thumb={p.id}
              class="rz-pick rz-thumb flex flex-[0_0_46%] flex-col gap-[8px] rounded-card bg-white p-[8px] text-start text-navy md:flex-auto"
            >
              {p.data.screenshotDesktop && portfolioImage(p.data.screenshotDesktop) ? (
                <Picture
                  src={portfolioImage(p.data.screenshotDesktop)!}
                  alt=""
                  formats={['avif', 'webp']}
                  widths={[240, 400]}
                  sizes="(min-width: 768px) 200px, 46vw"
                  loading="lazy"
                  decoding="async"
                  class="block aspect-[16/10] w-full rounded-[12px] border border-border object-cover object-top"
                />
              ) : (
                <span
                  aria-hidden="true"
                  class="flex aspect-[16/10] w-full items-center justify-center rounded-[12px] font-heading text-[22px] font-extrabold text-brand"
                  style={`background:${TINT[p.data.tint] ?? TINT.brand}`}
                >
                  {initialOf(p.data.name)}
                </span>
              )}
              <span class="flex min-w-0 flex-col px-[4px] pb-[4px]">
                <span class="text-[14px] leading-[1.3] font-bold">{p.data.name}</span>
                <span class="text-[12.5px] text-muted">{t.portfolio.industries[p.data.industry]}</span>
              </span>
            </button>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .rz-thumb {
    border: 1px solid var(--color-border);
  }
  .rz-thumb[aria-pressed='true'] {
    border: 2px solid var(--color-brand);
    padding: 7px;
  }
  .rz-proj:not([data-open]) {
    display: none;
  }
  .rz-proj[data-open][data-swapped] {
    animation: var(--animate-swap);
  }
</style>

<script>
  import '../../scripts/gallery';
</script>
