---
import type { GetStaticPaths } from 'astro';
import { blogData, pageSlice, PER_PAGE } from '../../lib/blog';
import BlogList from '../../views/BlogList.astro';

/** /blog/2/, /blog/3/ … (halaman 1 ada di /blog/). */
export const getStaticPaths = (async () => {
  const { articles } = await blogData();
  const last = Math.ceil(articles.length / PER_PAGE);
  return Array.from({ length: Math.max(0, last - 1) }, (_, i) => ({ params: { page: String(i + 2) } }));
}) satisfies GetStaticPaths;

const page = Number(Astro.params.page);
const { articles, cats } = await blogData();
const lastPage = Math.ceil(articles.length / PER_PAGE);
---

<BlogList
  articles={pageSlice(articles, page)}
  categories={cats}
  currentPage={page}
  lastPage={lastPage}
  baseUrl="/blog/"
/>
