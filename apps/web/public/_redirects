# Redirect 301 URL WordPress lama (docs/url-inventory.csv, PRD §9.6). Format Cloudflare _redirects.
/about/ /tentang/ 301
/about /tentang/ 301
/contact/ /kontak/ 301
/contact /kontak/ 301
# Kategori WordPress tanpa artikel di situs baru diarahkan ke /blog/.
/category/tips/ /blog/ 301
/category/tips /blog/ 301
/category/:cat/ /blog/kategori/:cat/ 301
/category/:cat /blog/kategori/:cat/ 301
/tag/* /blog/ 301
/author/* /tentang/ 301
/feed/ /rss.xml 301
/feed /rss.xml 301
/comments/feed/ /rss.xml 301
/wp-admin/* / 301
/wp-admin / 301
/wp-login.php / 301
/wp-sitemap.xml /sitemap-index.xml 301
/sitemap_index.xml /sitemap-index.xml 301
/post-sitemap.xml /sitemap-index.xml 301
/page-sitemap.xml /sitemap-index.xml 301
# Gambar lama (/wp-content/uploads/*) tidak dipindahkan; Cloudflare _redirects tidak mendukung 410,
